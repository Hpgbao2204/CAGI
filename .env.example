# Copy file này thành .env (KHÔNG commit .env — đã có trong .gitignore)
# và điền API key thật của bạn từ https://etherscan.io/myapikey
#
# Dùng cho eth/arbitrum qua Etherscan API V2 hợp nhất
# (api.etherscan.io/v2/api?chainid=...). Free tier KHÔNG hỗ trợ BSC (xem
# BSCTRACE_API_KEY bên dưới).
ETHERSCAN_API_KEY=your_key_here

# Dùng cho BSC (Etherscan free-tier chặn BSC) — đăng ký free tại
# https://nodereal.io/meganode, lấy API key cho BNB Chain.
# src/collect/bsctrace_client.py đọc BSCTRACE_API_KEY hoặc MEGANODE_API_KEY
# (fallback), chỉ cần điền 1 trong 2.
BSCTRACE_API_KEY=your_meganode_key_here
