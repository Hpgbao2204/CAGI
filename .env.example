# Copy to .env (never commit .env). Needed only to re-crawl data/raw.
# Ethereum + Arbitrum via Etherscan API V2 (free key: https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=your_key_here
# BSC via NodeReal MegaNode (free key: https://nodereal.io/meganode); the
# Etherscan free tier does not serve BSC. MEGANODE_API_KEY is also accepted.
BSCTRACE_API_KEY=your_key_here
